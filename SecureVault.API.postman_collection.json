            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('303 Redirect after import', () => pm.response.code === 303);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Entry (HTML form)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "url": { "raw": "{{base_url}}/update", "host": ["{{base_url}}"], "path": ["update"] },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "master", "value": "{{master_password}}" },
                { "key": "service", "value": "{{service_name}}" },
                { "key": "new_password", "value": "{{new_password}}" }
              ]
